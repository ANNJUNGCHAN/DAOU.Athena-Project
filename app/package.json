{
  "name": "athena-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Athena — Codex형 셸 창 Electron 앱 (중앙 캔버스 + 우측 채팅). 프로토타입.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit",
    "test:unit": "node --test lib/*.test.js lib/main/*.test.js lib/graph-mode/*.test.js",
    "test:provider-contract:unit": "node --test scripts/check-claude-agent-sdk-contract.test.mjs scripts/check-codex-app-server-contract.test.js scripts/write-provider-contract-decision.test.js scripts/check-provider-process-leaks.test.js",
    "probe:provider-contract": "node scripts/check-claude-agent-sdk-contract.mjs && node scripts/check-codex-app-server-contract.js && node scripts/write-provider-contract-decision.js --expect-decision CLAUDE_ONLY",
    "test:provider-contract": "npm run test:provider-contract:unit && npm run probe:provider-contract",
    "test:provider-sessions": "node --test scripts/benchmark-provider-sessions.test.js verify-provider-sessions.test.js scripts/verify-provider-sessions-electron.test.js scripts/run-claude-native-athena-live-benchmark.test.js",
    "benchmark:provider-sessions:node-injected": "node scripts/benchmark-provider-sessions.js",
    "benchmark:provider-sessions:claude-live-paired": "node scripts/run-claude-native-athena-live-benchmark.js",
    "verify:provider-sessions:node-injected": "node verify-provider-sessions.js --scenario all",
    "verify:provider-sessions:electron-runtime": "electron scripts/verify-provider-sessions-electron.js --scenario all",
    "verify:provider-sessions:os-leak": "node scripts/check-provider-process-leaks.js --record-path ../artifacts/provider-sessions/process-manifest.ndjson --grace-ms 5000 -- node verify-provider-sessions.js --scenario all --require-orchestrator",
    "gate:provider-sessions:pure": "npm run test:provider-sessions && npm run benchmark:provider-sessions:node-injected -- --provider claude --mode deterministic --samples 1000 && npm run benchmark:provider-sessions:node-injected -- --provider codex --mode assert-disabled --samples 30 && npm run verify:provider-sessions:node-injected",
    "verify": "electron verify.js",
    "verify:kiumi": "electron verify-kiumi.js",
    "verify:hoga-live": "electron verify-hoga-live.js",
    "verify:integrated-cards": "electron verify-integrated-cards.js",
    "verify:semantic-workspaces": "electron verify-semantic-workspaces.js",
    "verify:settings": "electron verify-settings.js",
    "verify:settings-cards": "electron verify-settings-cards.js",
    "verify:life003": "node verify-life003.js",
    "capture:wide15": "electron capture-wide15.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^43.4.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "lightweight-charts": "^5.2.1"
  }
}
