# 비밀값 — 절대 커밋 금지
.env
.env.*
!.env.example

# 에이전트/오케스트레이터 런타임 상태 — 재현 가능한 제품 산출물이 아님
.claude/
.codex/
.omc/
.omx/
.unlazy/
.unlazy-hook-state.json

# 외부 저장소 클론 — 커밋 금지
vendor/

# 빌드/캐시
node_modules/
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# playwright MCP 실행 찌꺼기
.playwright-mcp/

# 디자인 레퍼런스 스크린샷 드롭 — 커밋 금지
/toss-*.png
/audit-*.png
/paper-*.png
/app/design-references/

# 로컬 실행 증거(스윕 덤프·프로브 출력·핸드오프 키트·.bak) — 재현 가능하므로 커밋 금지
/artifacts/

# npm 패키지 내려받기 찌꺼기 — 의존성은 package.json이 소유한다
/package/
/*.tgz

# QA eval-run artifacts (screenshots/observations) - not for commit
datasets/eval-runs/
