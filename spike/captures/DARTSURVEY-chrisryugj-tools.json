    {
      "name": "search_disclosures",
      "title": null,
      "description": "DART 공시 검색 (3 모드): 기본(단일 페이지, page+size), preset(22개 프리셋 자동 필터+전량 병렬), all_pages(프리셋 없이 기간 전체 병렬). rcp_no(rcept_no) 로 download_document / get_attachments 연동.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "corp": {
            "description": "회사명/종목코드/corp_code. 생략 시 전체",
            "type": "string"
          },
          "begin": {
            "description": "시작일 YYYY-MM-DD (생략 시 기본값)",
            "type": "string"
          },
          "end": {
            "description": "종료일 (생략 시 오늘)",
            "type": "string"
          },
          "days": {
            "description": "begin 대신 오늘 기준 과거 N일 (preset 모드 기본 7, 일반 90)",
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "kind": {
            "description": "공시유형: periodic/major/issuance/holdings/audit/other/fund/abs/exchange/ftc",
            "type": "string",
            "enum": [
              "periodic",
              "major",
              "issuance",
              "holdings",
              "other",
              "audit",
              "fund",
              "abs",
              "exchange",
              "ftc"
            ]
          },
          "preset": {
            "description": "프리셋 22종: treasury_buy/sell/trust · cb/bw/eb_issue · rights_offering/bonus_issue/capital_reduction · merger/split/stock_exchange · business_transfer/acquisition · large_holding_5pct · annual_report/half_report/quarterly_report · audit_report · correction_all · insolvency · litigation. 지정 시 kind·키워드 자동 + 전량 페이지 병렬 수집.",
            "type": "string",
            "enum": [
              "treasury_buy",
              "treasury_sell",
              "treasury_trust",
              "cb_issue",
              "bw_issue",
              "eb_issue",
              "rights_offering",
              "bonus_issue",
              "capital_reduction",
              "merger",
              "split",
              "stock_exchange",
              "business_transfer",
              "business_acquisition",
              "large_holding_5pct",
              "annual_report",
              "half_report",
              "quarterly_report",
              "audit_report",
              "correction_all",
              "insolvency",
              "litigation"
            ]
          },
          "final_only": {
            "default": false,
            "description": "최종보고서만 (정정공시 제외)",
            "type": "boolean"
          },
          "include_corrections": {
            "default": false,
            "description": "정정공시 포함 (preset 모드 전용). correction_all 은 자동 true.",
            "type": "boolean"
          },
          "all_pages": {
            "default": false,
            "description": "preset 없이도 기간 전체를 병렬 수집. true 시 page/size 대신 limit 적용.",
            "type": "boolean"
          },
          "page": {
            "default": 1,
            "description": "페이지 모드 시 페이지 번호",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "size": {
            "default": 20,
            "description": "페이지 모드 시 페이지 크기",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "limit": {
            "default": 500,
            "description": "배치 모드 최종 반환 개수 상한",
            "type": "integer",
            "minimum": 1,
            "maximum": 3000
          },
          "concurrency": {
            "default": 5,
            "description": "배치 모드 페이지 병렬 동시성 (1~10, 기본 5). 높이면 빠르지만 DART 일일 20,000건 한도/분당 쿼터 근접 위험.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      },
      "outputSchema": null,
      "icons": null,
      "annotations": null,
      "meta": null,
      "execution": null
    },
