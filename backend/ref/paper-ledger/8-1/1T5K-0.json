  "검증": 1,
  "1": 1,
  "# athena strategy v1 — signals(df, p) 하나만 요구한다.": 1,
  "2": 1,
  "# df: open/high/low/close/volume · index=거래일(오름차순)": 1,
  "3": 1,
  "# 돌려줄 것: entry·exit 불리언 두 열. 체결·비용은 앱이 맡는다.": 1,
  "4": 1,
  "import athena_bt as bt": 1,
  "5": 1,
  "6": 1,
  "PARAMS = {": 1,
  "7": 1,
  "    \"fast\": {\"default\": 20, \"min\": 5,  \"max\": 60,  \"step\": 1},": 1,
  "8": 1,
  "    \"slow\": {\"default\": 60, \"min\": 20, \"max\": 240, \"step\": 1},": 1,
  "9": 1,
  "    \"atr_mult\": {\"default\": 2.0, \"min\": 0.5, \"max\": 5.0, \"step\": 0.1},": 1,
  "10": 1,
  "}": 1,
  "11": 1,
  "12": 1,
  "def signals(df, p):": 1,
  "13": 1,
  "    fast = bt.sma(df.close, p[\"fast\"])": 1,
  "14": 1,
  "    slow = bt.sma(df.close, p[\"slow\"])": 1,
  "15": 1,
  "    atr  = bt.atr(df, 14)": 1,
  "16": 1,
  "17": 1,
  "    entry = bt.cross_above(fast, slow)": 1,
  "18": 1,
  "19": 1,
  "    # 폼으로는 못 쓰는 조건 — 진입 시점 ATR에 묶인 손절선.": 1,
  "20": 1,
  "    stop = (df.close - atr * p[\"atr_mult\"]).where(entry).ffill()": 1,
  "21": 1,
  "    exit_ = bt.cross_below(fast, slow) | (df.low <= stop)": 1,
  "22": 1,
  "23": 1,
  "    return df.assign(entry=entry, exit=exit_)[[\"entry\", \"exit\"]]": 1,
