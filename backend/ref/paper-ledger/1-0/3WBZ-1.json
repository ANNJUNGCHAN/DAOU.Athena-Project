   "text": "def signal(df, k=0.62):\n    rng = df.high.shift(1) - df.low.shift(1)\n    target = df.open + rng * k\n    entry = df.high >= target\n    stop = df.close < df.open * 0.97\n    return entry.astype(int) - stop.astype(int)",
