  "돌파 계수 k": 1,
  "0.62": 1,
  "손절 · 수수료": 1,
  "-3.0% · 0.015%": 1,
  "strategy.py · 84 lines": 1,
  "restored": 1,
  "def signal(df, k=0.62):\n    rng = df.high.shift(1) - df.low.shift(1)\n    target = df.open + rng * k\n    entry = df.high >= target\n    stop = df.close < df.open * 0.97\n    return entry.astype(int) - stop.astype(int)": 1,
  "전략": 1,
  "매수보유": 1,
  "누적 수익률": 1,
