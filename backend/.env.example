# Kiwoom mock credentials. Leave unset to run docs and inspect OpenAPI only.
#
# Kiwoom's REST protocol has no account-number field: a request is attributed to whichever
# account issued its bearer token. One account therefore means one app key / secret key pair,
# and several accounts mean several pairs.
#
# Configure them as ONE JSON array. Do not repeat ATHENA_KIWOOM_APP_KEY on separate lines:
# .env keeps only the last value of a repeated key, so every earlier account is dropped silently.
#
# alias must match ^[a-z0-9][a-z0-9_-]{0,31}$ and is what callers send in the
# X-Athena-Account header, or an ?account= query parameter on websocket handshakes.
#
# order_scopes is an optional allowlist per account. Omit it for unrestricted:
#   "cash"   kt10000-kt10003  일반 주문       /api/dostk/ordr
#   "credit" kt10006-kt10009  신용(융자) 주문  /api/dostk/crdordr
#   "gold"   kt50000-kt50003  금현물 주문      /api/dostk/ordr
#   []       query-only: every order family is refused with HTTP 403
# Kiwoom's REST surface has no short-sell order operation, so a 대주/공매도 account
# belongs on [] rather than on a scope of its own.
ATHENA_KIWOOM_ACCOUNTS=[{"alias":"main","app_key":"","secret_key":"","order_scopes":["cash"]}]

# Which alias serves requests that do not name an account.
# Optional with exactly one account; required as soon as there are two or more.
ATHENA_KIWOOM_DEFAULT_ACCOUNT=main

# Single-account shorthand, still supported. Becomes a one-entry pool aliased "default".
# Setting it together with ATHENA_KIWOOM_ACCOUNTS is an error, not a merge.
# ATHENA_KIWOOM_APP_KEY=
# ATHENA_KIWOOM_SECRET_KEY=

ATHENA_ENABLE_ORDER_API=false
# Required by order routes when the order API is enabled. Use a long random local-only value.
ATHENA_LOCAL_BEARER_TOKEN=

# This backend is deliberately locked to the Kiwoom mock domain.
ATHENA_KIWOOM_BASE_URL=https://mockapi.kiwoom.com
ATHENA_REQUEST_TIMEOUT_SECONDS=10
ATHENA_MAX_RATE_LIMIT_RETRIES=1
ATHENA_MAX_PAGES=100
